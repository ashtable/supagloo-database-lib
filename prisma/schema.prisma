// Minimal bootstrap schema (Task #1). Zero models on purpose — real models
// land in later tasks (#4/#5). This exists so `prisma generate` produces a real
// generated client that gets compiled into dist/ and shipped with the package.
//
// Prisma 7 note: the datasource block no longer accepts `url`/`env(...)`. The
// connection URL is supplied at runtime via a driver adapter (or prisma.config.ts
// for the CLI), which is a later concern — only the API repo runs migrations.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  runtime             = "nodejs"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

// --- Task #4: identity, sessions, provider connections (design-delta §2.1–2.5) ---
// Connection URL is supplied by prisma.config.ts (CLI/migrations) and by the
// createPrismaClient() driver-adapter factory (runtime) — never inline here.

model User {
  id                    String    @id @default(cuid())
  youversionUserId      String    @unique
  displayName           String
  email                 String
  avatarInitials        String
  firstSignInAt         DateTime  @default(now())
  onboardingCompletedAt DateTime?
  lastSeenAt            DateTime  @default(now())
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  sessions   Session[]
  github     GithubConnection?
  openrouter OpenRouterConnection?
  gloo       GlooConnection?

  // --- Task #5 back-relations (virtual; FK columns live on the child side) ---
  projects       Project[]
  renderJobs     RenderJob[]
  aiGenerations  AiGeneration[]
  projectJobs    ProjectJob[]
  galleryItems   GalleryItem[]
  galleryUpvotes GalleryUpvote[]
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  // Task #42: the daily cleanupOrphanedAssets workflow purges `Session WHERE
  // "expiresAt" < now()`. Sessions are SLIDING — every authenticated request
  // re-stamps expiresAt — so this is the busiest small table in the schema, and the
  // purge without this index is a full sequential scan of it. The purge keys on
  // expiresAt ONLY; createdAt/lastUsedAt would evict live users.
  @@index([expiresAt])
}

// GitHub App installation (§2.3). installationId is the ONLY stored
// credential-pointer; no long-lived repo token is ever persisted — tokens are
// minted on demand. There is deliberately NO token column on this model.
model GithubConnection {
  userId              String   @id
  githubLogin         String
  installationId      String
  repositorySelection String
  status              String
  connectedAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OpenRouterConnection {
  userId           String   @id
  apiKeyCiphertext String
  keyLast4         String
  status           String
  connectedAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GlooConnection {
  userId                 String   @id
  clientId               String
  clientSecretCiphertext String
  status                 String
  connectedAt            DateTime @default(now())
  lastVerifiedAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// --- Task #5: projects, versions, jobs, renders, gallery (design-delta §2.6–2.9) ---
//
// Enums are fully specified by the design doc, so they are real Prisma enums
// (Task #4's underspecified status fields stayed plain String). No @map/@@map —
// camelCase Prisma names equal Postgres names verbatim.
//
// Composition/Scene are deliberately absent: the Remotion composition is a
// repo-committed `supagloo.project.json` manifest (memory:
// composition-source-of-truth-in-repo), never a Postgres table. AiGeneration
// carries a plain `sceneId` string (a manifest scene id, not a DB FK).
//
// `id` on RenderJob / AiGeneration / ProjectJob has NO @default: the id IS the
// DBOS workflow id, supplied by the caller at enqueue time. Surrogate-PK models
// (Project, ProjectVersion, GalleryItem, GalleryUpvote) use cuid(), per #4.
//
// onDelete: every FK is Cascade — to User (the #4 convention) and to the
// owning aggregate root (owned-child rule). See the Task #5 TDD plan §1 for the
// shared-JobStatus and all-Cascade decisions (both flagged for review).

enum RepoVisibility {
  private
  public
}

enum ProjectCreatedFrom {
  votd
  passage
  blank
  demo
  import
}

enum ProjectVersionState {
  base
  working
  published
  archived
}

enum RenderStatus {
  queued
  bundling
  synthesizing
  encoding
  uploading
  completed
  failed
  canceled
}

enum GalleryVisibility {
  public
  unlisted
}

enum AiGenerationKind {
  storyboard
  script
  image
  narration
  music
  video
}

enum AiProvider {
  gloo
  openrouter
}

enum ProjectJobKind {
  scaffold
  import_verify
  commit
  publish
}

// Shared by ProjectJob.status AND AiGeneration.status — identical lifecycle for
// both DBOS-workflow-backed job tables (queued → running → terminal). RenderJob
// keeps its own richer RenderStatus. See TDD plan §1 #1.
enum JobStatus {
  queued
  running
  succeeded
  failed
  canceled
}

model Project {
  id                String             @id @default(cuid())
  slug              String
  ownerId           String
  name              String
  repoOwner         String
  repoName          String
  repoVisibility    RepoVisibility
  createdFrom       ProjectCreatedFrom
  currentBranch     String
  thumbnailAssetKey String?
  lastRenderJobId   String?
  lastOpenedAt      DateTime           @default(now())
  createdAt         DateTime           @default(now())
  deletedAt         DateTime? // soft delete — the repo's first soft-delete field

  owner         User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  versions      ProjectVersion[]
  jobs          ProjectJob[]
  renderJobs    RenderJob[]
  aiGenerations AiGeneration[]
  galleryItems  GalleryItem[]

  @@unique([ownerId, slug]) // slug is unique PER OWNER, not globally
  @@index([ownerId])
  // Task #49 — "one repo <-> one project PER OWNER", enforced by a RAW-SQL PARTIAL
  // UNIQUE index that the Prisma DSL cannot express (`@@unique` has no `where`):
  //
  //   CREATE UNIQUE INDEX "Project_ownerId_repoOwner_repoName_active_key"
  //     ON "Project"("ownerId", "repoOwner", "repoName")
  //     WHERE "deletedAt" IS NULL;
  //
  // It lives in migration `..._session_expiry_and_project_repo_indexes`. The name is a
  // cross-repo contract, exported as PROJECT_ACTIVE_REPO_UNIQUE_INDEX with its reader
  // `isUniqueViolationOn` (src/constraints.ts): the API matches a P2002 against it to
  // answer the losing concurrent POST /v1/projects with 409 project_exists instead of a
  // raw 500. MEASURED: on Prisma 7.8.0 + @prisma/adapter-pg the violated name is NOT in
  // `meta.target` (which does not exist) — it is only in
  // `meta.driverAdapterError.cause.originalMessage`. Use the exported reader.
  //
  // Do NOT "fix" this by adding `@@unique([ownerId, repoOwner, repoName])`: a TOTAL
  // unique counts soft-deleted rows, so deleting a project would permanently block
  // ever re-creating one for that repo. The `WHERE "deletedAt" IS NULL` predicate is
  // the whole point.
  //
  // MEASURED (Prisma 7.8.0, both directions, against a pristine scratch DB carrying
  // exactly the committed migrations): `prisma migrate diff --from-config-datasource
  // --to-schema` reports "No difference detected." (exit 0). Prisma's diff engine does
  // NOT treat a predicated index it cannot model as drift, so this index costs no
  // standing diff noise. The only permanent diff entry against the shared dev DB
  // remains DBOS's out-of-Prisma `noop_proof` table. Re-measure on a Prisma upgrade —
  // if a future engine starts reporting it, that is expected and must not be
  // "reconciled" by dropping the index.
}

model ProjectVersion {
  id            String              @id @default(cuid())
  projectId     String
  semver        String
  branchName    String
  state         ProjectVersionState
  commitMessage String?
  autoSummary   String?
  changedFiles  Json
  headCommitSha String?
  prNumber      Int?
  prUrl         String?
  publishedAt   DateTime?

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  renderJobs  RenderJob[]
  projectJobs ProjectJob[]

  @@unique([projectId, semver])
  @@index([projectId])
}

model RenderJob {
  id                String       @id // = DBOS workflow id (no @default)
  projectId         String
  versionId         String
  userId            String
  status            RenderStatus
  framesDone        Int          @default(0)
  framesTotal       Int          @default(0)
  width             Int
  height            Int
  fps               Int
  aspectRatio       String
  codec             String
  outputAssetKey    String?
  thumbnailAssetKey String?
  runInBackground   Boolean
  error             String?
  createdAt         DateTime     @default(now())
  startedAt         DateTime?
  completedAt       DateTime?

  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version     ProjectVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  galleryItem GalleryItem?

  @@index([projectId])
  @@index([versionId])
  @@index([userId])
}

model AiGeneration {
  id             String           @id // = DBOS workflow id (no @default)
  userId         String
  projectId      String?
  sceneId        String? // manifest scene id — NOT a DB FK (scenes aren't persisted)
  kind           AiGenerationKind
  provider       AiProvider
  model          String
  input          Json
  status         JobStatus
  providerJobId  String? // persisted immediately post-submit for replay safety
  resultJson     Json?
  resultAssetKey String?
  error          String?
  tokenUsage     Json?
  createdAt      DateTime         @default(now())
  completedAt    DateTime?

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([projectId])
}

model GalleryItem {
  id                 String            @id @default(cuid())
  renderJobId        String            @unique // one gallery entry per render
  projectId          String
  ownerId            String
  title              String
  description        String
  scriptureReference String
  translation        String
  // INTERNAL normalized book code (e.g. GEN). Derived at PUBLISH time from
  // `scriptureReference` by database-lib's `deriveScriptureBook` (`scripture-book.ts`);
  // never client-supplied. NOTHING QUERIES IT — the gallery listing offers sort +
  // free-text `q` and no book filter (the filter was cut 2026-07-26: which books exist
  // is a property of the translation, YouVersion's authority, not a canon we hardcode).
  // It rides out on the DTO and may be displayed as text, but it is never a control.
  scriptureBook      String
  durationSeconds    Int
  videoAssetKey      String
  thumbnailAssetKey  String
  visibility         GalleryVisibility
  publishedAt        DateTime          @default(now())
  upvoteCount        Int               @default(0) // denormalized; updated txn-ally with GalleryUpvote
  viewCount          Int               @default(0)
  // Turn 16a — the watch page's "HOW IT WAS MADE" snapshot, validated by
  // database-lib's `GalleryMakingOfSchema` (`src/schemas.ts`). Captured ONCE at publish
  // time from the project's repo manifest, by the authenticated owner, so the PUBLIC
  // read never touches GitHub and never holds an installation token.
  //
  // NULLABLE with NO default, and both halves are load-bearing: the capture is BEST
  // EFFORT (a failed manifest read still returns 201) and every item published before
  // this column existed has no snapshot — so `null` is a permanent, first-class case
  // meaning "we do not have this", which a `{}` default would erase into "captured, and
  // empty". Deliberately NOT indexed: it is read by primary key only.
  makingOf           Json?

  renderJob RenderJob       @relation(fields: [renderJobId], references: [id], onDelete: Cascade)
  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner     User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  upvotes   GalleryUpvote[]

  @@index([projectId])
  @@index([ownerId])
  // RETAINED DELIBERATELY though no query uses it today (the book filter was cut
  // 2026-07-26): kept against a future book facet, because dropping it would cost a
  // schema migration deployed to every environment for zero read benefit.
  @@index([scriptureBook])
  // Task #39 — composite sort indexes for the PUBLIC listing, the only endpoint in the
  // system not scoped to one user (every other list narrows by ownerId/userId and rides
  // an index above). Plain ASCENDING composites are correct: Postgres scans a btree
  // backwards, so these serve `ORDER BY <key> DESC, "id" DESC` AND the keyset
  // pagination predicate `(<key>, "id") < ($k, $i)`. The `trending` expression contains
  // `now`, so it is not indexable without a stored score column — design-delta §2.7
  // explicitly defers that.
  @@index([visibility, publishedAt, id]) // sort=newest
  @@index([visibility, upvoteCount, id]) // sort=popular (the DEFAULT sort)
}

model GalleryUpvote {
  id            String   @id @default(cuid())
  userId        String
  galleryItemId String
  createdAt     DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  galleryItem GalleryItem @relation(fields: [galleryItemId], references: [id], onDelete: Cascade)

  @@unique([userId, galleryItemId])
  @@index([galleryItemId])
}

model ProjectJob {
  id          String         @id // = DBOS workflow id (no @default)
  projectId   String
  userId      String
  versionId   String?
  kind        ProjectJobKind
  status      JobStatus
  stages      Json // array of { key, label, state: pending|running|done|failed }
  error       String?
  createdAt   DateTime       @default(now())
  completedAt DateTime?

  project Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  version ProjectVersion? @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([userId])
  @@index([versionId])
}
